{
  "name": "dsh-llm-mlx",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for local MLX-LM models with loopback-only defaults and optional managed server startup",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "tsup src/index.ts --format esm --dts --clean --out-dir lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:dist": "npm run compile && git diff --exit-code -- lib && test -z \"$(git ls-files --others --exclude-standard -- lib)\"",
    "check": "npm run typecheck && npm run test && npm run verify:dist && npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robbywang25/dsh-llm-mlx.git"
  },
  "homepage": "https://github.com/robbywang25/dsh-llm-mlx#readme",
  "bugs": {
    "url": "https://github.com/robbywang25/dsh-llm-mlx/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mlx",
    "mlx-lm",
    "local-ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.0-rc.6 <0.1.1 || >=0.1.1-rc.1 <1.0.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "24.10.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
